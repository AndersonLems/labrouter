[Unit]
Description=LAB Router native SOAP/CWMP agent
After=network-online.target lab-router-api.service
Wants=network-online.target

[Service]
Type=simple
User=lab-router
Group=lab-router
EnvironmentFile=/etc/lab-router/environment
ExecStart=/usr/local/lib/lab-router/lab-router cwmp
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lab-router
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
